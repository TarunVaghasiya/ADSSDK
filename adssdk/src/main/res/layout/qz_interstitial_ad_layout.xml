<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQZLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/custom_label"
            android:fontFamily="@font/fig_tree_bold"
            android:paddingHorizontal="@dimen/_2sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:text="@string/native_ad_attribution"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_8sdp"
            tools:ignore="RelativeOverlap" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivQZClose"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/custom_button"
            android:backgroundTint="@color/card_background"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary" />

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/_20sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQZAppMedia"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_140sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/_20sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivQZAppIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:fontFamily="@font/fig_tree_bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/ad_headline_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZAppDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/fig_tree_medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/ad_body_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvQZRate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_18sdp"
                            android:fontFamily="@font/fig_tree_medium"
                            android:gravity="center"
                            android:text="@string/ad_body_placeholder"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_12sdp" />

                        <androidx.appcompat.widget.AppCompatRatingBar
                            android:id="@+id/rbQZRating"
                            android:layout_width="@dimen/quiz_rating_bar_width"
                            android:layout_height="@dimen/quiz_rating_star_size"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:isIndicator="true"
                            android:max="5"
                            android:numStars="5"
                            android:progressDrawable="@drawable/quiz_interstitial_rating_bar"
                            android:rating="4.5"
                            android:stepSize="0.1"
                            tools:rating="4.7" />

                    </LinearLayout>

                    <!--                    <View-->
                    <!--                        android:layout_width="@dimen/_1sdp"-->
                    <!--                        android:layout_height="@dimen/_40sdp"-->
                    <!--                        android:layout_marginHorizontal="@dimen/_20sdp"-->
                    <!--                        android:alpha="0.2"-->
                    <!--                        android:background="@color/text_secondary" />-->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_verified" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvQZUser"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/quiz_rating_star_size"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/fig_tree_medium"
                            android:gravity="center"
                            android:text="@string/ad_body_placeholder"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_12sdp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnQZClick"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/fig_tree_bold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_5sdp"
                android:singleLine="true"
                android:text="@string/ad_install"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_12sdp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>