<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/_5sdp"
        android:layout_weight="1.1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQZAppIcon"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_label"
                    android:fontFamily="@font/fig_tree_bold"
                    android:paddingHorizontal="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:text="@string/native_ad_attribution"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_7sdp"
                    tools:ignore="RelativeOverlap" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/fig_tree_bold"
                    android:maxLines="2"
                    android:text="Ad Headline"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_11sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQZAppDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:fontFamily="@font/fig_tree_medium"
            android:maxLines="3"
            android:text="Ad Body"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_9sdp"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnQZClick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/custom_button"
            android:fontFamily="@font/fig_tree_bold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_5sdp"
            android:singleLine="true"
            android:text="Install"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_12sdp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivQZAppMedia"
        android:layout_width="0dp"
        android:layout_height="@dimen/_140sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_weight="0.9" />

</LinearLayout>