<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivQZAppIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_label"
                    android:fontFamily="@font/fig_tree_bold"
                    android:paddingHorizontal="@dimen/_2sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    android:text="@string/native_ad_attribution"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_7sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQZAppTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/fig_tree_bold"
                    android:singleLine="true"
                    android:text="@string/ad_headline_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_11sdp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQZAppDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/fig_tree_medium"
                android:maxLines="2"
                android:text="@string/ad_body_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivQZAppMedia"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_140sdp"
        android:layout_marginVertical="@dimen/_10sdp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnQZClick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:background="@drawable/custom_button"
        android:fontFamily="@font/fig_tree_bold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_5sdp"
        android:singleLine="true"
        android:text="@string/ad_install"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_12sdp" />

</LinearLayout>